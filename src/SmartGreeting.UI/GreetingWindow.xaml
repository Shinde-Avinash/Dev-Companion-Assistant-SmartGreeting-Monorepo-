<Window x:Class="SmartGreeting.UI.GreetingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartGreeting.UI"
        mc:Ignorable="d"
        Title="SmartGreeting"
        Width="430"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system, sans-serif">

    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{Binding TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" Width="26" Height="26">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{Binding AccentBrush}"/>
            <Setter Property="Foreground" Value="#111318"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootContainer" Margin="14" Opacity="0" RenderTransformOrigin="0.5, 0.5">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" Y="20"/>
        </Grid.RenderTransform>

        <!-- Outer Card Border with Shadow -->
        <Border Background="{Binding CardBackgroundBrush}"
                BorderBrush="{Binding CardBorderBrush}"
                BorderThickness="1.2"
                CornerRadius="16"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.45"/>
            </Border.Effect>

            <Grid>
                <!-- Subtle Gradient Glow Layer -->
                <Rectangle Fill="{Binding CardGradient}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0.9"/>

                <!-- Content Grid -->
                <Grid Margin="20,18,20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header / Tag -->
                        <RowDefinition Height="Auto"/> <!-- Headline -->
                        <RowDefinition Height="Auto"/> <!-- Body -->
                        <RowDefinition Height="Auto"/> <!-- Subtle message -->
                        <RowDefinition Height="Auto"/> <!-- Footer / Action -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Tag & Close -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Icon Pill -->
                            <Border Background="{Binding AccentBrush}" CornerRadius="10" Padding="7,3" Margin="0,0,10,0" Opacity="0.95">
                                <TextBlock Text="{Binding IconGlyph}" FontSize="13" Foreground="#111318" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Uppercase Tag -->
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="Bold"
                                       FontSize="11"
                                       Foreground="{Binding AccentBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Close Button -->
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource IconButton}"
                                Click="OnCloseClicked"
                                ToolTip="Dismiss">
                            <TextBlock Text="✕" FontSize="11" FontWeight="Bold"/>
                        </Button>
                    </Grid>

                    <!-- Row 1: Headline -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding Headline}"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{Binding TextPrimaryBrush}"
                               Margin="0,14,0,6"
                               TextWrapping="Wrap"/>

                    <!-- Row 2: Body -->
                    <TextBlock Grid.Row="2"
                               Text="{Binding Body}"
                               FontSize="13.5"
                               Foreground="{Binding TextPrimaryBrush}"
                               Opacity="0.92"
                               LineHeight="19"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap"/>

                    <!-- Row 3: Subtle Message Box -->
                    <Border Grid.Row="3"
                            Background="#15FFFFFF"
                            BorderBrush="{Binding AccentBrush}"
                            BorderThickness="2,0,0,0"
                            CornerRadius="0,6,6,0"
                            Padding="10,7"
                            Margin="0,2,0,14">
                        <TextBlock Text="{Binding SubtleMessage}"
                                   FontSize="12"
                                   FontStyle="Italic"
                                   Foreground="{Binding TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Row 4: Footer -->
                    <Grid Grid.Row="4" Margin="0,2,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡ SmartGreeting"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="{Binding TextSecondaryBrush}"
                                       Opacity="0.75"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource ActionButton}"
                                    Content="Start Coding 🚀"
                                    Click="OnStartCodingClicked"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Thin Auto-Dismiss Progress Bar at Bottom -->
                <ProgressBar x:Name="DismissProgressBar"
                             VerticalAlignment="Bottom"
                             Height="2.5"
                             Background="Transparent"
                             Foreground="{Binding AccentBrush}"
                             BorderThickness="0"
                             Value="{Binding Progress}"
                             Maximum="100"/>
            </Grid>
        </Border>
    </Grid>
</Window>
