<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="SmartGreeting.Avi.6e5c9a72" Version="1.0.0" Language="en-US" Publisher="Avi" />
    <DisplayName>SmartGreeting — Intelligent Greetings for Visual Studio</DisplayName>
    <Description xml:space="preserve">Modern, time-aware greetings for Visual Studio with customizable working hours, day-of-week intelligence, anti-repetition, and Windows 11 Fluent design.</Description>
    <MoreInfo>https://local.smartgreeting.extension</MoreInfo>
    <License>LICENSE</License>
    <Icon>Resources\icon.png</Icon>
    <PreviewImage>Resources\preview.png</PreviewImage>
    <Tags>greeting, morning, time, welcome, productivity, fluent, developer</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0, 18.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[16.0, 17.0)">
      <ProductArchitecture>x86</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.7.2,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0, 18.0)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="File" Path="SmartGreeting.pkgdef" />
    <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="File" Path="SmartGreeting.dll" />
    <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="File" Path="SmartGreeting.Core.dll" />
    <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="File" Path="SmartGreeting.UI.dll" />
  </Assets>
</PackageManifest>
