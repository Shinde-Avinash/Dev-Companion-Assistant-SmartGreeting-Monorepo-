<Window x:Class="SmartGreeting.Vsix.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About SmartGreeting"
        Height="420" Width="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Border Background="#1C1E26" BorderBrush="#0078D4" BorderThickness="1.5" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <Border Background="#0078D4" CornerRadius="12" Width="44" Height="44" Margin="0,0,16,0">
                    <TextBlock Text="⚡" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SmartGreeting" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Intelligent Greetings for Visual Studio • Version 1.0.0" FontSize="12" Foreground="#9AA0A6"/>
                </StackPanel>
            </StackPanel>

            <!-- Details -->
            <StackPanel Grid.Row="1" Margin="0,4,0,16">
                <TextBlock Text="SmartGreeting welcomes you to your coding sessions with context-aware messages tailored to the time of day, day of the week, and your custom working hours."
                           FontSize="13" Foreground="#D0D4DC" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,16"/>

                <Border Background="#242732" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="✨ Core Features" FontWeight="SemiBold" FontSize="12" Foreground="#0078D4" Margin="0,0,0,8"/>
                        <TextBlock Text="• Offline-First: 100% private, zero telemetry, zero external APIs" FontSize="12" Foreground="#BAC2D0" Margin="0,0,0,4"/>
                        <TextBlock Text="• Context-Aware: Morning, Afternoon, Evening &amp; Late Night awareness" FontSize="12" Foreground="#BAC2D0" Margin="0,0,0,4"/>
                        <TextBlock Text="• Working Hours Aware: Understands before/during/after work" FontSize="12" Foreground="#BAC2D0" Margin="0,0,0,4"/>
                        <TextBlock Text="• Anti-Repetition: Fresh varied messages across consecutive sessions" FontSize="12" Foreground="#BAC2D0" Margin="0,0,0,4"/>
                        <TextBlock Text="• Lightweight &amp; Fast: Zero clock polling, zero VS startup delay" FontSize="12" Foreground="#BAC2D0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Author: Avi • Local Private Edition" FontSize="11" Foreground="#7A8292"/>
            </StackPanel>

            <!-- Action -->
            <Button Grid.Row="2"
                    HorizontalAlignment="Right"
                    Background="#0078D4"
                    Foreground="#FFFFFF"
                    FontWeight="SemiBold"
                    FontSize="12"
                    Padding="20,8"
                    Cursor="Hand"
                    Click="OnCloseClicked">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#108CEB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="Close"/>
            </Button>
        </Grid>
    </Border>
</Window>
