<Window x:Class="SmartGreeting.Vsix.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About SmartGreeting"
        Height="420" Width="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Border Background="#1C1E26" BorderBrush="#0078D4" BorderThickness="1.5" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <Border Background="#0078D4" CornerRadius="12" Width="44" Height="44" Margin="0,0,16,0">
                    <TextBlock Text="⚡" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SmartGreeting" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Intelligent Greetings for Visual Studio • Version 1.0.0" FontSize="12" Foreground="#9AA0A6"/>
                </StackPanel>
            </StackPanel>

            <!-- Tabs: Details, Features, Creator -->
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,4,0,16">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="#9AA0A6"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="12,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}" Margin="0,0,8,6" Cursor="Hand">
                                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="#0078D4"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#E0E0E0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- Tab 1: Details -->
                <TabItem Header="Details">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="DevCompanion welcomes you to your coding sessions with context-aware messages tailored to the time of day, day of the week, and your custom working hours."
                                   FontSize="13" Foreground="#D0D4DC" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,14"/>
                        <TextBlock Text="Author: Avinash Shinde • DevCompanion Edition" FontSize="11" Foreground="#7A8292"/>
                    </StackPanel>
                </TabItem>

                <!-- Tab 2: Features -->
                <TabItem Header="Features">
                    <Border Background="#242732" CornerRadius="8" Padding="14,12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="✨ Core Features" FontWeight="SemiBold" FontSize="12" Foreground="#0078D4" Margin="0,0,0,8"/>
                            <TextBlock Text="• Offline-First: 100% private, zero telemetry, zero external APIs" FontSize="12" Foreground="#BAC2D0" Margin="0,0,0,4"/>
                            <TextBlock Text="• Context-Aware: Morning, Afternoon, Evening &amp; Late Night awareness" FontSize="12" Foreground="#BAC2D0" Margin="0,0,0,4"/>
                            <TextBlock Text="• Wellness Reminders: Water hydration, coffee break, and posture reminders" FontSize="12" Foreground="#BAC2D0" Margin="0,0,0,4"/>
                            <TextBlock Text="• Anti-Repetition: Fresh varied messages across consecutive sessions" FontSize="12" Foreground="#BAC2D0" Margin="0,0,0,4"/>
                            <TextBlock Text="• Lightweight &amp; Fast: Zero clock polling, zero VS startup delay" FontSize="12" Foreground="#BAC2D0"/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- Tab 3: Creator -->
                <TabItem Header="Creator">
                    <Border Background="#242732" CornerRadius="8" Padding="16,14" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="👨‍💻 Created by Avinash Shinde" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" Margin="0,0,0,10"/>
                            <TextBlock Text="Connect and explore open-source projects:" FontSize="12" Foreground="#BAC2D0" Margin="0,0,0,12"/>
                            
                            <!-- LinkedIn -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="🔗 LinkedIn: " FontWeight="SemiBold" FontSize="12" Foreground="#0078D4"/>
                                <TextBlock Text="https://www.linkedin.com/in/avinash-shinde-7628b91a5/" FontSize="12" Foreground="#60A5FA" TextDecorations="Underline" Cursor="Hand" Tag="https://www.linkedin.com/in/avinash-shinde-7628b91a5/" MouseLeftButtonDown="OnLinkClick"/>
                            </StackPanel>

                            <!-- GitHub -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌐 GitHub: " FontWeight="SemiBold" FontSize="12" Foreground="#0078D4"/>
                                <TextBlock Text="https://github.com/Shinde-Avinash" FontSize="12" Foreground="#60A5FA" TextDecorations="Underline" Cursor="Hand" Tag="https://github.com/Shinde-Avinash" MouseLeftButtonDown="OnLinkClick"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>

            <!-- Action -->
            <Button Grid.Row="2"
                    HorizontalAlignment="Right"
                    Background="#0078D4"
                    Foreground="#FFFFFF"
                    FontWeight="SemiBold"
                    FontSize="12"
                    Padding="20,8"
                    Cursor="Hand"
                    Click="OnCloseClicked">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#108CEB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="Close"/>
            </Button>
        </Grid>
    </Border>
</Window>
